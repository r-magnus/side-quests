{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "side-quests",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs (including errors the app reports via /api/log) in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  // Human-written quests from finished games (server/src/catalog.ts). Local `wrangler dev` simulates this
  // with no setup; deployed, it's a real D1 database (`wrangler d1 create side-quests-catalog`).
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "CATALOG", "database_name": "side-quests-catalog", "database_id": "60ceb201-0de6-49ef-b3b4-59a9f1ad2b42" }],
  // The web app (npm run web:build) is served from the same address as the game,
  // so a join link works in any phone browser. /api/* goes to the game code;
  // any other unknown path (e.g. /join/ABCD) falls back to the app.
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Dev shortcuts (bots via DEV menu, skip to end, seeding). Set to "0" in production.
  "vars": { "DEV_TOOLS": "1" }
}
