{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/ensure-web.mjs && wrangler d1 migrations apply CATALOG --local && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "node ../scripts/ensure-web.mjs && wrangler deploy --var DEV_TOOLS:0",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/geocode.test.mjs src/ratings.test.mjs src/tiles.test.mjs"
  },
  "dependencies": {
    "@side-quests/game": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  }
}
